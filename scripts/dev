#!/bin/bash

# ==============================================================================
# dev - Development session starter with tmux + git worktree
# ==============================================================================
# Usage:
#   dev                     # Start session in current directory
#   dev <name>              # Create worktree + session, then choose agent
#   dev -l                  # List sessions (worktree-based, with tmux status)
#   dev -c <name> [name...] # Clean up session(s) (tmux + worktree + branch)
#   dev -c --all            # Clean up ALL sessions for current repo
#   dev -c --orphans        # Clean up sessions without active tmux
#   DEV_CLEAN_JOBS=8 dev -c --all  # Clean up with up to 8 workers
# ==============================================================================

set -e

# Colors
RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[0;33m'
BLUE='\033[0;34m'
DIM='\033[2m'
NC='\033[0m'

# Defaults
SESSION_NAME=""
SESSION_NAMES=()
LIST_MODE=false
CLEAN_MODE=false
CLEAN_ALL=false
CLEAN_ORPHANS=false
CLEAN_JOBS="${DEV_CLEAN_JOBS:-4}"
TMUX_ORIGINAL_EXIT_EMPTY=""

# Parse arguments
while [[ $# -gt 0 ]]; do
    case $1 in
        -l|--list)
            LIST_MODE=true
            shift
            ;;
        -c|--clean)
            CLEAN_MODE=true
            shift
            ;;
        --all)
            CLEAN_ALL=true
            shift
            ;;
        --orphans)
            CLEAN_ORPHANS=true
            shift
            ;;
        -h|--help)
            echo "Usage: dev [options] [name]"
            echo ""
            echo "Options:"
            echo "  -l, --list              List sessions (worktree + tmux status)"
            echo "  -c, --clean <name>...   Clean up session(s) (tmux + worktree + branch)"
            echo "  -c --all                Clean up ALL sessions for current repo"
            echo "  -c --orphans            Clean up sessions without active tmux"
            echo "  -h, --help              Show this help"
            echo ""
            echo "Examples:"
            echo "  dev                     # Start session in current directory"
            echo "  dev s1                  # Create worktree + session"
            echo "  dev -l                  # List all sessions"
            echo "  dev -c s1               # Clean up session"
            echo "  dev -c s1 s2 s3         # Clean up multiple sessions"
            echo "  dev -c --all            # Clean up all sessions"
            echo "  dev -c --orphans        # Clean up orphaned sessions"
            exit 0
            ;;
        -*)
            echo -e "${RED}Unknown option: $1${NC}"
            exit 1
            ;;
        *)
            SESSION_NAMES+=("$1")
            shift
            ;;
    esac
done

# Multiple names are only meaningful for clean mode
if [[ ${#SESSION_NAMES[@]} -gt 1 ]] && [[ "$CLEAN_MODE" != true ]]; then
    echo -e "${RED}Error: Multiple names are only supported with -c/--clean${NC}"
    exit 1
fi
[[ ${#SESSION_NAMES[@]} -gt 0 ]] && SESSION_NAME="${SESSION_NAMES[0]}"

# Helper: check if tmux session exists
_tmux_session_exists() {
    tmux has-session -t "=$1" 2>/dev/null
}

# ------------------------------------------------------------------------------
# Issue title lookup (optional): if a session name starts with an issue key
# (e.g. ABC-123) and the `linear` CLI is installed and authenticated, `dev -l`
# shows the issue title. Auth and titles live outside this repo
# (~/.config/linear, ~/.cache/dev) so nothing project-specific is committed.
# ------------------------------------------------------------------------------
TITLE_CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/dev/issue-titles"
TITLE_MAX_LEN="${DEV_TITLE_MAX_LEN:-40}"

# Extract a leading issue key (ABC-123) from a session name, uppercased
_issue_key() {
    local name
    name=$(echo "$1" | tr '[:lower:]' '[:upper:]')
    if [[ "$name" =~ ^[A-Z][A-Z0-9]*-[0-9]+ ]]; then
        echo "${BASH_REMATCH[0]}"
    fi
}

# Fetch and cache a title (cache entries expire after a day)
_fetch_issue_title() {
    local key="$1"
    local cache="$TITLE_CACHE_DIR/$key"
    if [[ -f "$cache" ]] && [[ -n $(find "$cache" -mtime -1 2>/dev/null) ]]; then
        return 0
    fi
    local title
    title=$(linear issue title "$key" 2>/dev/null || true)
    if [[ -n "$title" ]]; then
        mkdir -p "$TITLE_CACHE_DIR"
        printf '%s' "$title" > "$cache"
    fi
}

# Read a cached title, truncated for display
_issue_title() {
    local cache="$TITLE_CACHE_DIR/$1"
    [[ -f "$cache" ]] || return 0
    local title
    title=$(<"$cache")
    if (( ${#title} > TITLE_MAX_LEN )); then
        title="${title:0:$((TITLE_MAX_LEN - 1))}…"
    fi
    printf '%s' "$title"
}

# Keep the tmux server alive until Resurrect records the post-cleanup state.
_prepare_tmux_snapshot_sync() {
    if tmux list-sessions &>/dev/null; then
        TMUX_ORIGINAL_EXIT_EMPTY=$(tmux show-options -gv exit-empty)
        tmux set-option -g exit-empty off
    fi
}

_restore_tmux_exit_empty() {
    if [[ -n "$TMUX_ORIGINAL_EXIT_EMPTY" ]] && tmux display-message -p '#{pid}' &>/dev/null; then
        tmux set-option -g exit-empty "$TMUX_ORIGINAL_EXIT_EMPTY"
        TMUX_ORIGINAL_EXIT_EMPTY=""
    fi
}

_sync_tmux_snapshot() {
    local save_script=""

    if tmux display-message -p '#{pid}' &>/dev/null; then
        save_script=$(tmux show-options -gqv @resurrect-save-script-path)
    fi

    if [[ -n "$save_script" ]] && [[ -x "$save_script" ]]; then
        echo -e "  ${BLUE}Updating tmux restore snapshot...${NC}"
        if ! "$save_script" quiet >/dev/null; then
            echo -e "  ${YELLOW}Warning: Failed to update tmux restore snapshot.${NC}" >&2
        fi
    fi

    _restore_tmux_exit_empty
}

# Helper: choose AI agent for the code window
_select_agent() {
    if command -v fzf &>/dev/null; then
        printf "claude\ncodex\nopencode\n" | fzf --height=7 --layout=reverse --prompt="Agent: " || true
    else
        echo "1) claude  2) codex  3) opencode" >&2
        read -p "Choose agent [1-3]: " choice
        case $choice in
            2) echo "codex" ;;
            3) echo "opencode" ;;
            *) echo "claude" ;;
        esac
    fi
}

# Helper: clean up a single session by name
_clean_session() {
    local name="$1"
    local repo_root="$2"
    local sanitized=$(echo "$name" | tr ' ./' '_')

    echo -e "${YELLOW}Cleaning up: $name${NC}"

    # 1. Stop tmux session
    if _tmux_session_exists "dev_$sanitized"; then
        echo -e "  ${BLUE}Stopping tmux session...${NC}"
        tmux kill-session -t "=dev_$sanitized"
    fi

    # 2. Remove worktree and branch
    if [[ -n "$repo_root" ]]; then
        local repo_name=$(basename "$repo_root")
        local worktree_dir="$repo_root/../.worktrees/$repo_name/$name"

        if [[ -d "$worktree_dir" ]]; then
            echo -e "  ${BLUE}Removing worktree...${NC}"
            git -C "$repo_root" worktree remove "$worktree_dir" --force 2>/dev/null || true
        fi

        if git -C "$repo_root" show-ref --verify --quiet "refs/heads/$name" 2>/dev/null; then
            echo -e "  ${BLUE}Deleting branch...${NC}"
            git -C "$repo_root" branch -D "$name" 2>/dev/null || true
        fi
    fi
}

# Clean multiple sessions concurrently while bounding the number of workers.
_clean_sessions_parallel() {
    local repo_root="$1"
    shift
    local -a pids=()
    local failed=0

    for name in "$@"; do
        while [[ ${#pids[@]} -ge $CLEAN_JOBS ]]; do
            if ! wait "${pids[0]}"; then
                failed=1
            fi
            pids=("${pids[@]:1}")
        done

        _clean_session "$name" "$repo_root" &
        pids+=("$!")
    done

    for pid in "${pids[@]}"; do
        if ! wait "$pid"; then
            failed=1
        fi
    done

    return "$failed"
}

# List mode: worktree-based with tmux status
if [[ "$LIST_MODE" == true ]]; then
    REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
    if [[ -z "$REPO_ROOT" ]]; then
        echo -e "${RED}Error: Not in a git repository${NC}"
        exit 1
    fi

    REPO_NAME=$(basename "$REPO_ROOT")
    WORKTREE_BASE="$REPO_ROOT/../.worktrees/$REPO_NAME"

    if [[ ! -d "$WORKTREE_BASE" ]] || [[ -z "$(ls -A "$WORKTREE_BASE" 2>/dev/null)" ]]; then
        echo "No dev sessions for $REPO_NAME"
        exit 0
    fi

    # Prefetch issue titles concurrently (cache misses only)
    if command -v linear &>/dev/null; then
        title_pids=()
        for wt_dir in "$WORKTREE_BASE"/*/; do
            [[ -d "$wt_dir" ]] || continue
            key=$(_issue_key "$(basename "$wt_dir")")
            [[ -n "$key" ]] || continue
            _fetch_issue_title "$key" &
            title_pids+=("$!")
        done
        for pid in "${title_pids[@]}"; do
            wait "$pid" 2>/dev/null || true
        done
    fi

    echo -e "${GREEN}Sessions for ${BLUE}$REPO_NAME${NC}:"
    echo ""

    for wt_dir in "$WORKTREE_BASE"/*/; do
        [[ -d "$wt_dir" ]] || continue
        wt_name=$(basename "$wt_dir")
        sanitized=$(echo "$wt_name" | tr ' ./' '_')
        tmux_name="dev_$sanitized"

        # Get branch info
        branch=$(git -C "$wt_dir" rev-parse --abbrev-ref HEAD 2>/dev/null || echo "?")

        title=""
        key=$(_issue_key "$wt_name")
        [[ -n "$key" ]] && title=$(_issue_title "$key")

        if _tmux_session_exists "$tmux_name"; then
            # Get window count
            win_count=$(tmux list-windows -t "=$tmux_name" 2>/dev/null | wc -l | tr -d ' ')
            echo -e "  ${GREEN}*${NC} ${wt_name}  ${DIM}[$branch]${NC}  ${GREEN}${win_count} windows${NC}${title:+  ${DIM}${title}${NC}}"
        else
            echo -e "  ${DIM}-${NC} ${wt_name}  ${DIM}[$branch]  (no tmux)${NC}${title:+  ${DIM}${title}${NC}}"
        fi
    done
    echo ""
    exit 0
fi

# Clean mode
if [[ "$CLEAN_MODE" == true ]]; then
    if ! [[ "$CLEAN_JOBS" =~ ^[1-9][0-9]*$ ]]; then
        echo -e "${RED}Error: DEV_CLEAN_JOBS must be a positive integer${NC}"
        exit 1
    fi

    _prepare_tmux_snapshot_sync
    trap _restore_tmux_exit_empty EXIT

    REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)

    # --all: clean everything for this repo
    if [[ "$CLEAN_ALL" == true ]]; then
        if [[ -z "$REPO_ROOT" ]]; then
            echo -e "${RED}Error: Not in a git repository${NC}"
            exit 1
        fi
        REPO_NAME=$(basename "$REPO_ROOT")
        WORKTREE_BASE="$REPO_ROOT/../.worktrees/$REPO_NAME"

        if [[ ! -d "$WORKTREE_BASE" ]]; then
            echo "No worktrees to clean for $REPO_NAME"
            exit 0
        fi

        names=()
        for wt_dir in "$WORKTREE_BASE"/*/; do
            [[ -d "$wt_dir" ]] || continue
            names+=("$(basename "$wt_dir")")
        done

        if [[ ${#names[@]} -eq 0 ]]; then
            echo "No worktrees to clean for $REPO_NAME"
            exit 0
        fi

        echo -e "${YELLOW}Will clean ${#names[@]} sessions for $REPO_NAME:${NC}"
        printf '  %s\n' "${names[@]}"
        echo ""
        read -p "Continue? [y/N] " confirm
        [[ "$confirm" =~ ^[yY]$ ]] || exit 0

        if ! _clean_sessions_parallel "$REPO_ROOT" "${names[@]}"; then
            echo -e "${RED}Some sessions failed to clean up.${NC}"
            exit 1
        fi
        _sync_tmux_snapshot
        echo -e "${GREEN}All done!${NC}"
        exit 0
    fi

    # --orphans: clean worktrees without active tmux sessions
    if [[ "$CLEAN_ORPHANS" == true ]]; then
        if [[ -z "$REPO_ROOT" ]]; then
            echo -e "${RED}Error: Not in a git repository${NC}"
            exit 1
        fi
        REPO_NAME=$(basename "$REPO_ROOT")
        WORKTREE_BASE="$REPO_ROOT/../.worktrees/$REPO_NAME"

        if [[ ! -d "$WORKTREE_BASE" ]]; then
            echo "No worktrees to clean for $REPO_NAME"
            exit 0
        fi

        orphans=()
        for wt_dir in "$WORKTREE_BASE"/*/; do
            [[ -d "$wt_dir" ]] || continue
            wt_name=$(basename "$wt_dir")
            sanitized=$(echo "$wt_name" | tr ' ./' '_')
            if ! _tmux_session_exists "dev_$sanitized"; then
                orphans+=("$wt_name")
            fi
        done

        if [[ ${#orphans[@]} -eq 0 ]]; then
            echo "No orphaned sessions for $REPO_NAME"
            exit 0
        fi

        echo -e "${YELLOW}Orphaned sessions (no active tmux):${NC}"
        printf '  %s\n' "${orphans[@]}"
        echo ""
        read -p "Clean up all ${#orphans[@]} orphans? [y/N] " confirm
        [[ "$confirm" =~ ^[yY]$ ]] || exit 0

        if ! _clean_sessions_parallel "$REPO_ROOT" "${orphans[@]}"; then
            echo -e "${RED}Some sessions failed to clean up.${NC}"
            exit 1
        fi
        _sync_tmux_snapshot
        echo -e "${GREEN}All done!${NC}"
        exit 0
    fi

    # Named session clean (one or more)
    if [[ ${#SESSION_NAMES[@]} -eq 0 ]]; then
        echo -e "${RED}Error: Specify session name(s). Usage: dev -c <name> [name...]${NC}"
        exit 1
    fi

    if [[ ${#SESSION_NAMES[@]} -eq 1 ]]; then
        _clean_session "${SESSION_NAMES[0]}" "$REPO_ROOT"
    else
        if ! _clean_sessions_parallel "$REPO_ROOT" "${SESSION_NAMES[@]}"; then
            echo -e "${RED}Some sessions failed to clean up.${NC}"
            exit 1
        fi
    fi
    _sync_tmux_snapshot
    echo -e "${GREEN}Done!${NC}"
    exit 0
fi

# Determine target path and session name
if [[ -n "$SESSION_NAME" ]]; then
    # Name provided: create worktree
    REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
    if [[ -z "$REPO_ROOT" ]]; then
        echo -e "${RED}Error: Not in a git repository${NC}"
        exit 1
    fi
    
    REPO_NAME=$(basename "$REPO_ROOT")
    WORKTREE_DIR="$REPO_ROOT/../.worktrees/$REPO_NAME/$SESSION_NAME"
    
    if [[ -d "$WORKTREE_DIR" ]]; then
        echo -e "${YELLOW}Using existing worktree: $WORKTREE_DIR${NC}"
    else
        echo -e "${GREEN}Creating worktree: $SESSION_NAME${NC}"
        mkdir -p "$REPO_ROOT/../.worktrees/$REPO_NAME"
        
        if git -C "$REPO_ROOT" show-ref --verify --quiet "refs/heads/$SESSION_NAME" 2>/dev/null; then
            git -C "$REPO_ROOT" worktree add "$WORKTREE_DIR" "$SESSION_NAME"
        else
            git -C "$REPO_ROOT" worktree add -b "$SESSION_NAME" "$WORKTREE_DIR"
        fi

        # Copy .env files from main worktree (skip prod configs)
        if command -v fd &>/dev/null; then
            fd -H -I '^\.env' -E node_modules -E '.claude/worktrees' "$REPO_ROOT" | while read -r src; do
                rel="${src#$REPO_ROOT/}"
                # Skip prod env files
                if [[ "$rel" == *prod* ]]; then
                    continue
                fi
                dest="$WORKTREE_DIR/$rel"
                mkdir -p "$(dirname "$dest")"
                cp "$src" "$dest"
                echo -e "  ${DIM}Copied: $rel${NC}"
            done
        fi
    fi
    
    TARGET_PATH="$WORKTREE_DIR"
else
    # No name: use current directory
    TARGET_PATH=$(pwd)
    SESSION_NAME=$(basename "$TARGET_PATH")
fi

# Keep original name for cleanup, then sanitize for tmux
ORIGINAL_SESSION_NAME="$SESSION_NAME"
SESSION_NAME=$(echo "$SESSION_NAME" | tr ' ./' '_')
TMUX_SESSION="dev_$SESSION_NAME"

echo -e "${GREEN}Starting: ${BLUE}$SESSION_NAME${NC}"

# Check if tmux session already exists
if tmux has-session -t "=$TMUX_SESSION" 2>/dev/null; then
    echo -e "${YELLOW}Session exists.${NC}"
    
    if command -v fzf &>/dev/null; then
        ACTION=$(echo -e "attach\nrestart\nstop" | fzf --height=5 --layout=reverse --prompt="Action: ")
    else
        echo "1) attach  2) restart  3) stop"
        read -p "Choose [1-3]: " choice
        case $choice in
            1) ACTION="attach" ;;
            2) ACTION="restart" ;;
            3) ACTION="stop" ;;
            *) ACTION="attach" ;;
        esac
    fi
    
    case "$ACTION" in
        "attach")
            tmux attach-session -t "=$TMUX_SESSION"
            exit 0
            ;;
        "restart")
            tmux kill-session -t "=$TMUX_SESSION" 2>/dev/null || true
            sleep 0.5
            ;;
        "stop")
            REPO_ROOT=$(git rev-parse --show-toplevel 2>/dev/null)
            _clean_session "$ORIGINAL_SESSION_NAME" "$REPO_ROOT"
            echo -e "${GREEN}Stopped.${NC}"
            exit 0
            ;;
        *)
            exit 0
            ;;
    esac
fi

# Ensure tmux server is running (let continuum restore finish first)
if ! tmux list-sessions 2>/dev/null; then
    tmux start-server
    sleep 1
fi

AGENT_CMD=$(_select_agent)
if [[ -z "$AGENT_CMD" ]]; then
    echo -e "${YELLOW}Canceled.${NC}"
    exit 0
fi

# Start tmux session with code and diff windows
tmux new-session -d -s "$TMUX_SESSION" -n "code" -c "$TARGET_PATH"
tmux send-keys -t "=$TMUX_SESSION:code" "$AGENT_CMD" Enter

tmux new-window -t "=$TMUX_SESSION" -n "diff" -c "$TARGET_PATH"
tmux send-keys -t "=$TMUX_SESSION:diff" "hunk diff" Enter

tmux select-window -t "=$TMUX_SESSION:code"
tmux attach-session -t "=$TMUX_SESSION"
